{
  "name": "pireel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Pireel Studio — an open-source, backend-free AI video editor for talking-head video. The canvas follows your source footage; editing, preview, timeline, and client export run fully in the browser.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @pireel/studio-oss-shell dev",
    "build": "pnpm --filter @pireel/studio-oss-shell build",
    "preview": "pnpm --filter @pireel/studio-oss-shell preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.176",
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-json-patch": "^3.1.1",
    "jsondiffpatch": "^0.7.6",
    "lucide-react": "^1.14.0",
    "mediabunny": "^1.45.4",
    "nanoid": "^5.1.11",
    "onnxruntime-web": "^1.27.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.13.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.5"
  }
